// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id                String                @id @default(cuid())
  title             String
  description       String?
  servings          Int?
  prepMinutes       Int?
  cookMinutes       Int?
  instructions      String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  recipeIngredients RecipeIngredient[]
  propertyScores    RecipePropertyScore[]
}

model Ingredient {
  id                String             @id @default(cuid())
  name              String             @unique
  defaultUnit       String?
  // Set once, manually confirmed by a user matching this ingredient against
  // BLS search results — never auto-matched. All nutrient data lives on the
  // matched BlsFood/BlsFoodNutrient rows, not duplicated here.
  blsFoodCode       String?
  blsFood           BlsFood?           @relation(fields: [blsFoodCode], references: [blsCode])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  recipeIngredients RecipeIngredient[]

  @@index([blsFoodCode])
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  ingredientId String
  amount       Float
  unit         String
  createdAt    DateTime   @default(now())
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
}

model Property {
  id               String                    @id @default(cuid())
  key              String                    @unique
  label            String
  description      String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  recipeScores     RecipePropertyScore[]
  conditionWeights ConditionPropertyWeight[]
}

model RecipePropertyScore {
  id         String   @id @default(cuid())
  recipeId   String
  propertyId String
  score      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([recipeId, propertyId])
  @@index([propertyId, score])
}

// Bundeslebensmittelschlüssel (BLS) 4.0 reference data, imported from the
// official BLS data package (see README "Data sources"). BlsFood and
// BlsNutrientComponent use the BLS-assigned codes as primary keys (rather
// than a generated cuid, unlike the app's own models above) since they're
// stable external identifiers and importing ~870k BlsFoodNutrient rows is
// simpler and faster when it can reference codes directly instead of
// resolving generated ids first.
model BlsFood {
  blsCode     String            @id
  nameDe      String
  nameEn      String?
  // Derived from the BLS code's leading letter at import time, using the
  // category browser at blsdb.de (the BLS documentation itself doesn't
  // publish this mapping) — see FOOD_GROUP_BY_LETTER in import-bls.ts.
  foodGroup   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  nutrients   BlsFoodNutrient[]
  ingredients Ingredient[]

  @@index([nameDe])
}

model BlsNutrientComponent {
  code        String            @id
  nameDe      String
  nameEn      String?
  unit        String
  group       String?
  groupEn     String?
  formula     String?
  formulaNote String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  values      BlsFoodNutrient[]
}

// One row per (food, nutrient) pair instead of one wide row per food.
// A pair with no data at all in the source ("-") is simply not imported
// as a row here; `value` is null only for a pair that has a qualifier
// (e.g. "TR" for trace, below the detection/quantification limit) but no
// exact number.
model BlsFoodNutrient {
  foodCode      String
  componentCode String
  value         Float?
  qualifier     String?
  source        String?
  reference     String?
  createdAt     DateTime             @default(now())
  food          BlsFood              @relation(fields: [foodCode], references: [blsCode], onDelete: Cascade)
  component     BlsNutrientComponent @relation(fields: [componentCode], references: [code], onDelete: Restrict)

  @@id([foodCode, componentCode])
  @@index([componentCode])
}

model Condition {
  id          String                    @id @default(cuid())
  key         String                    @unique
  label       String
  description String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  weights     ConditionPropertyWeight[]
}

model ConditionPropertyWeight {
  id          String    @id @default(cuid())
  conditionId String
  propertyId  String
  weight      Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  condition   Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([conditionId, propertyId])
  @@index([propertyId, weight])
}
